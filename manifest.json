{
    "author": "Digit",
    "manifest_version": 2,
    "name": "SharpViewer",
    "version": "1.2.5",
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "permissions": [
        "tabs",
        "storage",
        "<all_urls>"
    ],
    "icons": {
        "128": "icons/icon128.png",
        "16": "icons/icon16.png",
        "64": "icons/icon64.png",
        "48": "icons/icon48.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "sharp-viewer@rebitwise.com"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    }
}