{
    "author": "Digit",
    "manifest_version": 3,
    "name": "SharpViewer",
    "version": "1.3.1",
    "background": {
        "scripts": ["background.js"],
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "scripting",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "128": "icons/icon128.png",
        "16": "icons/icon16.png",
        "64": "icons/icon64.png",
        "48": "icons/icon48.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "sharp-viewer@rebitwise.com"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    }
}